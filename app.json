{
  "expo": {
    "name": "foodhabits.com",
    "slug": "foodhabits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodhabits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.foodhabits.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.foodhabits.app",
      "adaptiveIcon": {
        "backgroundColor": "#07120D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07120D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "foodhabits.com uses the camera to recognise the food on your plate. Photos stay on your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "foodhabits.com reads the meal photo you choose to recognise the food. Photos stay on your phone.",
          "cameraPermission": "foodhabits.com uses the camera to recognise the food on your plate. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      "react-native-fast-tflite",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "hi",
            "bn",
            "te",
            "mr",
            "ta",
            "ur",
            "gu",
            "kn",
            "ml",
            "or",
            "pa",
            "as",
            "es",
            "fr",
            "pt",
            "de",
            "ar",
            "zh",
            "ja",
            "ru",
            "id"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
